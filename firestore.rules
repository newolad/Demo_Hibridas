rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfiles de usuario ──────────────────────────────────────────
    match /users/{uid} {
      // Cualquier usuario autenticado puede leer su propio perfil
      allow read: if request.auth != null && request.auth.uid == uid;
      // Solo el propio usuario puede crear su perfil (lo hace al registrarse)
      allow create: if request.auth != null && request.auth.uid == uid;
      // Nadie puede modificar su propio rol desde el cliente (solo desde la consola de Firebase)
      allow update, delete: if false;
    }

    // ── Tareas ──────────────────────────────────────────────────────
    match /tasks/{taskId} {
      // El administrador puede leer todas las tareas
      // Para identificarlo leemos su perfil en /users/{uid}
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
